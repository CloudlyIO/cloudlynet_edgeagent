# Two ways to run the suite:
#   1. Full mock (self-contained)  -> use `make e2e` / `e2e-all` / `verify`. IGNORES this file.
#   2. Real cloud (acsftp)         -> copy this to `.env`, set the token, then `docker compose up`.
# This file exists only for #2. (Production/systemd runtime env is deploy/agent.env.example.)

# Mode: acsftp (mock device+FTP, agent talks to a REAL cloud) | full (all-mock)
EDGEAGENT_TESTSUITE_MODE=acsftp

# REQUIRED for acsftp: dashboard "add device" token + the deployed platform URL
CLOUDLYNET_ENROLLMENT_TOKEN=paste-token-from-dashboard
CLOUDLYNET_BASE_URL=https://netai.cloudly.io/

# Log scenario: happy | ftp-path-reject | ftp-auth-fail | ftp-conn-fail | ftp-timeout | atc-fault | reboot
EDGEAGENT_TESTSUITE_SCENARIO=happy

# Mock device identity -> cwmp_id. Change the serial to a UNIQUE value when several
# testers share one cloud (else the device cells collide).
EDGEAGENT_TESTSUITE_OUI=8C1F64
EDGEAGENT_TESTSUITE_PRODUCT_CLASS=ENB-N03002-B3
EDGEAGENT_TESTSUITE_SERIAL=2205609999

# Mock device -> local vsftpd creds (test-only; never the real box's password)
FTP_USER=nybsys
FTP_PASS=nybsys-local-test
