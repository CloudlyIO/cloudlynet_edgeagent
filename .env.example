# Copy to `.env`, set what you need, run. These are the ONLY knobs the
# docker-compose.test.yml harness reads (via ${VAR} interpolation). Container
# paths (FTP watch dir, buffer DB, CWMP listen) are fixed in the compose, not here.
# Production/systemd runtime env is a different file: deploy/agent.env.example.

# Emulator mode:
#   full   — mock cloud + mock device + real vsftpd (self-contained; default)
#   acsftp — mock device + real vsftpd, agent talks to a REAL cloud
EDGEAGENT_TESTSUITE_MODE=full

# Scenario for `full` mode (see testsuite/README.md):
#   happy | ftp-path-reject | ftp-auth-fail | ftp-conn-fail | ftp-timeout | atc-fault | reboot
EDGEAGENT_TESTSUITE_SCENARIO=happy

# For acsftp: paste the dashboard "add device" token, and set BASE_URL to the
# deployed platform (REQUIRED for acsftp — else the compose default points the
# agent at the mock). Leave BOTH empty for full mode.
CLOUDLYNET_ENROLLMENT_TOKEN=
CLOUDLYNET_BASE_URL=

# mock-device -> local vsftpd creds. Local test defaults ONLY — never the real box's password.
FTP_USER=nybsys
FTP_PASS=nybsys-local-test
